using Gtk 4.0;
using Adw 1;

template $Runner: $MorghulWindow {
    styles [
        "all_unset",
    ]

    title: "Runner";
    namespace: "Morghulis.Runner";
    anchor: top;
    keymode: exclusive;

    EventControllerKey {
        key-released => $key_released();
    }

    EventControllerKey {
        propagation-phase: capture;
        key-pressed => $key_pressed();
    }

    Box {
        orientation: vertical;
        width-request: 512;
        overflow: hidden;

        styles [
            "bottom_left_right_corner_borders",
        ]

        Box {
            overflow: hidden;

            styles [
                "background",
                "top_left_right_corner_borders",
            ]

            Revealer {
                transition-type: slide_left;
                transition-duration: 250;
                reveal-child: bind template.cmd_active;

                Adw.Bin {
                    styles [
                        "padding_5",
                        "view",
                    ]

                    Image {
                        icon-name: bind template.active_cmd_icon;
                        icon-size: large;
                    }
                }
            }

            Entry entry {
                height-request: 50;
                hexpand: true;
                primary-icon-name: "system-search-symbolic";
                changed => $update_list();
                activate => $launch_first_runner_button();
                placeholder-text: "Search... or type \":\" for commands";

                styles [
                    "title-4",
                    "squared",
                ]
            }
        }

        Box {
            spacing: 4;

            styles [
                "background",
                "provider-tabs",
            ]

            Button {
                icon-name: "go-previous-symbolic";
                tooltip-text: "Previous section (Left arrow)";
                clicked => $tab_prev();

                styles [
                    "flat",
                ]
            }

            Box {
                hexpand: true;
                halign: center;
                spacing: 4;

                Button apps_tab {
                    label: "Apps";
                    clicked => $tab_apps();

                    styles [
                        "flat",
                    ]
                }

                Button clip_tab {
                    label: "Clipboard";
                    clicked => $tab_clip();

                    styles [
                        "flat",
                    ]
                }

                Button files_tab {
                    label: "Files";
                    clicked => $tab_files();

                    styles [
                        "flat",
                    ]
                }
            }

            Button {
                icon-name: "go-next-symbolic";
                tooltip-text: "Next section (Right arrow)";
                clicked => $tab_next();

                styles [
                    "flat",
                ]
            }
        }

        Stack commands_stack {
            interpolate-size: true;
            hhomogeneous: false;
            vhomogeneous: false;
            transition-duration: 250;
            transition-type: slide_left_right;

            styles [
                "bottom_left_right_corner_borders",
                "view",
            ]

            StackPage {
                name: "apps";

                child: $AppsCmd {};
            }
        }
    }
}
