using Gtk 4.0;
using Adw 1;
using AstalNetwork 0.1;

template $QNetwork: Box {
    orientation: vertical;

    Adw.HeaderBar {
        [end]
        Box {
            spacing: 10;

            Revealer {
                transition-duration: 200;
                transition-type: slide_left;
                reveal-child: bind template.network as <AstalNetwork.Wifi>.scanning;

                Adw.Spinner spinner {}
            }

            Button {
                icon-name: "view-refresh-symbolic";
                clicked => $refresh();
            }
        }
    }

    styles [
        "view"
    ]

    ScrolledWindow {
        vexpand: true;

        ListBox items_list {
            selection-mode: none;

            styles [
                "boxed-list"
            ]
        }
    }
}
