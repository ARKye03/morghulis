using Gtk 4.0;
using Adw 1;
using Astal 4.0;
using AstalBattery 0.1;

template $NavBar: Astal.Window {
  styles [
    "top_left_right_corner_borders",
    "x_padding_5"
  ]

  title: "NavBar";
  namespace: "NavBar";
  exclusivity: exclusive;

  CenterBox {
    styles [
      "y_padding_5"
    ]

    [start]
    Box {
      spacing: 10;

      Adw.Bin {
        styles [
          "master_border",
          "view",
          "rounded"
        ]

        Button {
          icon-name: "view-grid-symbolic";
          name: "apps_button";
          clicked => $toggle_runner();
        }
      }

      Adw.Bin active_client {
        visible: false;

        styles [
          "x_padding_5",
          "master_border",
          "rounded",
          "view"
        ]
      }

      Adw.Bin active_submap {
        visible: false;

        styles [
          "master_border",
          "rounded",
          "view"
        ]
      }
    }

    [center]
    Adw.Bin workspaces {
      styles [
        "workspaces",
        "master_border",
        "rounded",
        "view"
      ]
    }

    [end]
    Box right_box {
      spacing: 10;

      Adw.Bin {
        styles [
          "master_border",
          "view",
          "rounded"
        ]

        MenuButton {
          valign: center;
          icon-name: "go-up-symbolic";

          styles [
            "tray_button"
          ]

          popover: Popover {
            position: top;
            height-request: 50;
            autohide: true;
            has-arrow: false;
            margin-bottom: 10;

            $Tray tray {}
          };
        }
      }

      Box {
        visible: bind template.battery as <AstalBattery.Device>.is-present;

        styles [
          "master_border",
          "rounded",
          "view"
        ]

        spacing: 10;

        Label {
          label: bind $current_battery(template.battery as <AstalBattery.Device>.percentage) as <string>;
        }

        Image {
          icon-name: bind template.battery as <AstalBattery.Device>.icon-name;
        }
      }

      Adw.Bin volume_bin {
        styles [
          "master_border",
          "view",
          "rounded"
        ]

        tooltip-text: "Volume";
      }

      Adw.Bin {
        styles [
          "master_border",
          "view",
          "rounded"
        ]

        MenuButton {
          styles [
            "nav_bar_label",
            "master_border",
            "rounded"
          ]

          Label clock {
            name: "clock";
          }

          popover: Popover {
            position: top;
            width-request: 350;
            height-request: 250;
            autohide: true;
            has-arrow: false;
            margin-bottom: 10;

            Calendar {}
          };
        }
      }

      Adw.Bin {
        styles [
          "master_border",
          "view",
          "rounded"
        ]

        Button power_button {
          icon-name: "system-shutdown-symbolic";
          name: "power_button";
          clicked => $toggle_side_dashboard();

          styles [
            "master_border",
            "rounded",
            "view",
          ]
        }
      }
    }
  }
}
