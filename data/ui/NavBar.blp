using Gtk 4.0;
using Adw 1;
using Astal 4.0;
using AstalBattery 0.1;

template $NavBar: Astal.Window {
  styles [
    "nav_bar_master"
  ]

  title: "NavBar";
  namespace: "NavBar";
  exclusivity: exclusive;

  CenterBox {
    [start]
    Box {
      spacing: 10;

      Button apps_button {
        icon-name: "view-grid-symbolic";
        name: "apps_button";
        clicked => $toggle_runner();

        styles [
          "nav_bar_box",
          "view",
          "nav_bar_button"
        ]
      }

      Adw.Bin active_client {
        visible: false;

        styles [
          "nav_bar_box",
          "view"
        ]
      }

      Adw.Bin active_submap {
        visible: false;

        styles [
          "nav_bar_box",
          "view"
        ]
      }
    }

    [center]
    Adw.Bin workspaces {
      styles [
        "workspaces",
        "nav_bar_box",
        "view"
      ]
    }

    [end]
    Box right_box {
      spacing: 10;

      styles [
        "right_box"
      ]

      Button {
        clicked => $tray_popover_popup();

        styles [
          "nav_bar_box",
          "view",
          "nav_bar_button"
        ]

        Box {
          Image tray_popover_icon {
            icon-name: "go-up-symbolic";
          }

          Popover tray_popover {
            position: top;
            height-request: 50;
            autohide: true;
            has-arrow: false;
            margin-bottom: 10;

            $Tray tray {}
          }
        }
      }

      Box {
        visible: bind template.battery as <AstalBattery.Device>.is-present;

        styles [
          "nav_bar_box",
          "view"
        ]

        spacing: 10;

        Label {
          label: bind $current_battery(template.battery as <AstalBattery.Device>.percentage) as <string>;
        }

        Image {
          icon-name: bind template.battery as <AstalBattery.Device>.icon-name;
        }
      }

      Button {
        clicked => $clock_popover_popup();

        styles [
          "nav_bar_label",
          "nav_bar_box",
          "nav_bar_button"
        ]

        Box {
          Popover clock_popover {
            position: top;
            width-request: 350;
            height-request: 250;
            autohide: true;
            has-arrow: false;
            margin-bottom: 10;

            Calendar {}
          }

          Label clock {
            name: "clock";
          }
        }
      }

      Button power_button {
        icon-name: "system-shutdown-symbolic";
        name: "power_button";
        clicked => $toggle_side_dashboard();

        styles [
          "nav_bar_box",
          "view",
          "nav_bar_button"
        ]
      }
    }
  }
}
