using Gtk 4.0;
using Adw 1;
using Astal 4.0;
using AstalHyprland 0.1;
using AstalBattery 0.1;

template $NavBar: Astal.Window {
  styles [
    "nav_bar_master"
  ]

  title: "NavBar";
  namespace: "NavBar";
  exclusivity: exclusive;
  keymode: on_demand;

  CenterBox {
    [start]
    Box {
      spacing: 10;

      Button apps_button {
        icon-name: "view-grid-symbolic";
        name: "apps_button";
        clicked => $toggle_runner();

        styles [
          "nav_bar_box",
          "view",
          "nav_bar_button"
        ]
      }

      Label client_label {
        halign: start;
        ellipsize: end;
        max-width-chars: 20;
        label: bind template.hyprland as <AstalHyprland.Hyprland>.focused-client as <AstalHyprland.Client>.title;
        visible: bind $focused_client_exists(template.hyprland as <AstalHyprland.Hyprland>.focused-client) as <bool>;
        tooltip-text: "Active client";

        styles [
          "client_label",
          "nav_bar_box",
          "view"
        ]
      }

      Label active_submap {
        halign: start;
        ellipsize: end;
        max-width-chars: 20;
        visible: false;
        tooltip-text: "Active submap";

        styles [
          "active_submap",
          "nav_bar_box",
          "view"
        ]
      }
    }

    [center]
    Adw.Bin workspaces {
      styles [
        "workspaces",
        "nav_bar_box",
        "view"
      ]
    }

    [end]
    Box right_box {
      spacing: 10;

      styles [
        "right_box"
      ]

      Overlay notif_overlay {
        Button {
          clicked => $notif_popover_popup();

          styles [
            "nav_bar_box",
            "view",
            "nav_bar_button"
          ]

          Box {
            Image notif_popover_icon {
              icon-name: "preferences-system-notifications-symbolic";
            }

            Popover notif_popover {
              position: top;
              width-request: 400;
              height-request: 450;
              autohide: true;
              has-arrow: false;
              margin-bottom: 10;

              $NotifWindow notif_window {}
            }
          }
        }

        [overlay]
        Label notif_count_label {
          styles [
            "notif_count_label",
            "view"
          ]

          halign: end;
          valign: start;
          xalign: 0.5;
          justify: center;
        }
      }

      Button {
        clicked => $tray_popover_popup();

        styles [
          "nav_bar_box",
          "view",
          "nav_bar_button"
        ]

        Box {
          Image tray_popover_icon {
            icon-name: "go-up-symbolic";
          }

          Popover tray_popover {
            position: top;
            height-request: 50;
            autohide: true;
            has-arrow: false;
            margin-bottom: 10;

            $Tray tray {}
          }
        }
      }

      Box {
        visible: bind template.battery as <AstalBattery.Device>.is-present;

        styles [
          "nav_bar_box",
          "view"
        ]

        spacing: 10;

        Label {
          label: bind $current_battery(template.battery as <AstalBattery.Device>.percentage) as <string>;
        }

        Image {
          icon-name: bind template.battery as <AstalBattery.Device>.icon-name;
        }
      }

      Button {
        clicked => $clock_popover_popup();

        styles [
          "nav_bar_label",
          "nav_bar_box",
          "nav_bar_button"
        ]

        Box {
          Popover clock_popover {
            position: top;
            width-request: 350;
            height-request: 250;
            autohide: true;
            has-arrow: false;
            margin-bottom: 10;

            Calendar {}
          }

          Label clock {
            name: "clock";
          }
        }
      }

      Button power_button {
        icon-name: "system-shutdown-symbolic";
        name: "power_button";
        clicked => $toggle_side_dashboard();

        styles [
          "nav_bar_box",
          "view",
          "nav_bar_button"
        ]
      }
    }
  }
}
