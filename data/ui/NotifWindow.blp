using Gtk 4.0;

template $NotifWindow: Box {
    orientation: vertical;

    ScrolledWindow {
        overflow: hidden;
        vexpand: true;

        styles [
            "notifications_scrolled_window"
        ]

        ListBox notifications {
            selection-mode: none;

            styles [
                "boxed-list-separate"
            ]
        }
    }

    Button {
        styles [
            "destructive-action"
        ]

        icon-name: "user-trash-symbolic";
        clicked => $clear_notifications();
    }
}
