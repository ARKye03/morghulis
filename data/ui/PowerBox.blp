using Gtk 4.0;
using Adw 1;

template $PowerBox: Box {
    hexpand: true;

    styles [
        "quick_settings_grid_box"
    ]

    Box {
        hexpand: true;
        halign: start;
        spacing: 10;

        Adw.Avatar {
            text: bind template.user_name;
            custom-image: bind template.user_image_paintable;
            show-initials: true;
            size: 30;
        }

        Label {
            label: bind template.user_name;
        }
    }

    Box {
        hexpand: true;
        spacing: 5;
        halign: end;

        Button {
            visible: false;
            icon-name: "colloid-morghulis-system-suspend-symbolic";
            tooltip-text: "Suspend";
            clicked => $suspend();
        }

        Button {
            visible: false;
            icon-name: "colloid-morghulis-system-hibernate-symbolic";
            tooltip-text: "Hibernate";
            clicked => $hibernate();
        }

        Button {
            icon-name: "colloid-morghulis-system-lock-screen-symbolic";
            tooltip-text: "Lock";
            clicked => $lock();
        }

        Button {
            icon-name: "colloid-morghulis-system-reboot-symbolic";
            tooltip-text: "Reboot";
            clicked => $reboot();
        }

        Button {
            icon-name: "colloid-morghulis-system-shutdown-symbolic";
            tooltip-text: "Shutdown";
            clicked => $shutdown();
        }
    }
}
