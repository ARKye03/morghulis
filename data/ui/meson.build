blueprints = custom_target(
    'blueprints',
    input: files(
        'MprisPlayer.blp',
        'NavBar.blp',
        'NotificationItem.blp',
        'OnScreenDisplay.blp',
        'PowerBox.blp',
        'QBluetooth.blp',
        'QBluetoothItem.blp',
        'QButton.blp',
        'QNetwork.blp',
        'QNotifications.blp',
        'BatteryBox.blp',
        'QuickMenu.blp',
        'Runner.blp',
        'RunnerButton.blp',
        'Settings.blp',
        'QAudioBox.blp',
        'QAudioItem.blp',
        'PowerMenu.blp'
    ),
    output: '.',
    command: [
        find_program('blueprint-compiler'),
        'batch-compile',
        '@OUTPUT@',
        '@CURRENT_SOURCE_DIR@',
        '@INPUT@',
    ],
)