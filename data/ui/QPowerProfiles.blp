using Gtk 4.0;
using Adw 1;
using AstalBattery 0.1;
using AstalPowerProfiles 0.1;

template $QPowerProfiles: Box {
    orientation: vertical;

    styles [
        "view"
    ]

    Adw.HeaderBar {
        show-end-title-buttons: false;
    }

    Box {
        orientation: vertical;
        spacing: 10;

        styles [
            "padding_10"
        ]

        Adw.Bin {
            vexpand: true;

            styles [
                "padding_10"
            ]

            $CircularProgressBar {
                percentage: bind template.battery as <AstalBattery.Device>.percentage;
                line-width: 15;
                line-cap: round;

                child: Image {
                    icon-name: bind template.power_profiles as <AstalPowerProfiles.PowerProfiles>.icon-name;
                    icon-size: large;
                };
            }
        }

        Separator {}

        Box ppd_box {
            orientation: vertical;
            spacing: 10;
            homogeneous: true;
            hexpand: true;

            styles [
                "linked",
                "title-2"
            ]
        }
    }
}
