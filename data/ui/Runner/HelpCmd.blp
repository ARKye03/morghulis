using Gtk 4.0;

template $HelpCmd: Box {
    orientation: vertical;

    styles [
        "padding_10",
    ]

    Label {
        label: "Available commands";
        halign: center;

        styles [
            "title-1",
        ]
    }

    Separator {
        orientation: horizontal;
    }

    Box commands_box {
        orientation: vertical;
        spacing: 10;

        styles [
            "padding_10",
        ]

        Label {
            label: _("Press ctrl + c to reset the Entry");
            halign: start;

            styles [
                "title-3",
            ]
        }
    }
}
