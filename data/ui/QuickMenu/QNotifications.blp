using Gtk 4.0;
using Adw 1;

template $QNotifications: Box {
  orientation: vertical;

  Adw.HeaderBar {
    show-end-title-buttons: false;

    [end]
    Button {
      icon-name: "user-trash-symbolic";
      clicked => $clear_notifications();
    }
  }

  Stack {
    transition-duration: 250;
    transition-type: slide_up_down;
    visible-child-name: bind $get_stack_page_to_show(template.at_least_one_notification) as <string>;

    styles [
      "background",
    ]

    StackPage {
      name: "notifications";
      title: "Notifications";

      child: Overlay {
        [overlay]
        Revealer go_down_revealer {
          transition-duration: 200;
          transition-type: slide_up;
          reveal-child: true;
          halign: center;
          valign: end;

          styles [
            "float-y",
          ]

          Image {
            icon-name: "go-down-symbolic";
            pixel-size: 32;
            margin-bottom: 10;
          }
        }

        ScrolledWindow scrolled_window {
          overflow: hidden;
          vexpand: true;
          hscrollbar-policy: never;
          margin-top: 10;
          margin-end: 10;
          margin-bottom: 10;
          margin-start: 10;

          styles [
            "rounded",
          ]

          ListBox notif_list {
            selection-mode: none;

            styles [
              "boxed-list-separate",
            ]
          }
        }
      };
    }

    StackPage {
      name: "no_notifications";

      child: Box {
        orientation: vertical;
        spacing: 10;
        vexpand: true;
        halign: center;
        valign: center;

        styles [
          "background",
        ]

        Image {
          icon-name: "bell-minus-symbolic";
          pixel-size: 120;
        }

        Label {
          label: "No notifications";

          styles [
            "title-1",
          ]
        }
      };
    }
  }
}
