using Gtk 4.0;

template $QuickMenu: $Window {
    styles [
        "all_unset",
    ]

    default-width: 400;
    default-height: 1;
    title: "QuickMenu";
    namespace: "Morghulis.QuickMenu";
    anchor: bottom | right;
    margin-right: 5;
    margin-bottom: 5;

    Box {
        vexpand: true;
        orientation: vertical;
        spacing: 10;

        $Settings {
            // I hate this below
            height-request: 398;
            hexpand: true;
            vexpand: true;
        }

        $BatteryBox {
            hexpand: true;
            vexpand: false;
        }

        $PowerBox {
            hexpand: true;
            vexpand: false;
        }
    }
}
