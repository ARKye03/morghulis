using Gtk 4.0;
using Adw 1;

template $QBluetooth: Box {
  orientation: vertical;

  Adw.HeaderBar {
    show-end-title-buttons: false;

    [end]
    Button {
      tooltip-text: "Discover";
      clicked => $toggle_discover();

      Image scan_button_image {
        icon-name: "view-refresh-symbolic";
      }
    }
  }

  ScrolledWindow {
    vexpand: true;

    styles [
      "background",
      "padding_10",
    ]

    ListBox blue_list {
      show-separators: true;
      selection-mode: none;

      styles [
        "boxed-list",
      ]
    }
  }
}
