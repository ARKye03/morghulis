using Gtk 4.0;
using Adw 1;
using AstalBluetooth 0.1;

template $QBluetooth: Box {
    orientation: vertical;

    Adw.HeaderBar {
        show-end-title-buttons: false;

        [end]
        Box {
            spacing: 10;

            Revealer {
                transition-duration: 200;
                transition-type: slide_left;
                reveal-child: bind template.bluetooth as <AstalBluetooth.Bluetooth>.adapter as <AstalBluetooth.Adapter>.discovering;

                Adw.Spinner spinner {
                    tooltip-text: "What do you think?";
                }
            }

            Button {
                icon-name: "view-refresh-symbolic";
                tooltip-text: "Discover";
                clicked => $toggle_discover();
            }
        }
    }

    ScrolledWindow {
        vexpand: true;

        styles [
            "background",
            "padding_10",
        ]

        ListBox blue_list {
            show-separators: true;
            selection-mode: none;

            styles [
                "boxed-list",
            ]
        }
    }
}
